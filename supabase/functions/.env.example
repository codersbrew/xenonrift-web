# Optional Resend secrets for supabase/functions/testflight-signup.
# Without these, TestFlight signups are still stored in private.testflight_signups in Supabase Postgres.
# Set on hosted xenon with: env -u SUPABASE_ACCESS_TOKEN supabase secrets set --env-file supabase/functions/.env

# Resend API key (re_...). Enables syncing signups into Resend Contacts.
RESEND_API_KEY=
# Optional Resend Segment UUID to attach TestFlight contacts to for Broadcast waves.
RESEND_SEGMENT_ID=
# Optional verified sender (e.g. "Xenon Rift <playtest@xenonrift.com>"). When set alongside RESEND_API_KEY,
# sends one transactional confirmation email the first time an address joins the list.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=support@codersbrew.com
